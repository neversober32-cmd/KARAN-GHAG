{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd gatezero-kennels-rehoming-website && npm run build",
  "outputDirectory": "gatezero-kennels-rehoming-website/dist",
  "installCommand": "npm install --prefix gatezero-kennels-rehoming-website",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
