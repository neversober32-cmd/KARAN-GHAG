{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ghag-kennels-website && npm run build",
  "outputDirectory": "ghag-kennels-website/dist",
  "installCommand": "npm install --prefix ghag-kennels-website",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
